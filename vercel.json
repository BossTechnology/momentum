{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --omit=dev",
  "buildCommand": "node build/build.js && node build/engine.js",
  "outputDirectory": "public",
  "functions": {
    "api/bobby.mjs": {
      "maxDuration": 60
    },
    "api/profile.js": {
      "maxDuration": 300,
      "includeFiles": "api/_*.js"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/engine", "destination": "/engine/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/engine/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
