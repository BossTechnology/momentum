# MOMENTUM environment variables
# Copy to .env.local for local dev (vercel dev). NEVER commit .env.local.
# In production set these in Vercel → Project → Settings → Environment Variables.

# --- Claude proxy (api/bobby.mjs) -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# REQUIRED, not optional. api/profile.js returns 500 without it — it is the
# only credential that can write to the momentum-data bucket and the
# data_profiles table, both of which are behind RLS. It must never reach the
# browser; only the function reads it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# Optional — defaults to 'momentum-data'.
# MOMENTUM_DATA_BUCKET=momentum-data
