# MOMENTUM environment variables
# Copy to .env.local for local dev (vercel dev). NEVER commit .env.local.
# In production set these in Vercel → Project → Settings → Environment Variables.

# --- Claude proxy (api/bobby.mjs) -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Not read by anything. The front end contains no Supabase client and never
# talks to Supabase directly — persistence goes through api/profile.js. Kept
# for reference only.
# SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# REQUIRED, not optional. api/profile.js returns 500 without it — it is the
# only credential that can write to the momentum-data bucket and the
# data_profiles table, both of which are behind RLS. It must never reach the
# browser; only the function reads it.
# Newer projects issue opaque keys (sb_secret_..., sb_publishable_...) rather
# than the legacy eyJ... JWTs. Copy the SECRET one — the publishable key is
# rejected by RLS on write, and Storage rejects any non-JWT bearer token that
# is not also sent as an apikey header.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Optional — defaults to 'momentum-data'.
# MOMENTUM_DATA_BUCKET=momentum-data
